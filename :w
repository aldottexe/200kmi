<script lang="ts">
  import type { PageProps } from "./$types";
  let { data }: PageProps = $props();
  function parseSiteName(r: string): string {
    return r.match(/(?<=https?:\/\/)[^/]+/)[0];
  }
</script>

<div class="m10p">
  <h1>{data.title}</h1>
  <article>
    <div class="content">
      <p>{@html data.intro}</p>

      <ol>
        {#each data.steps as step}
          <li>
            <h3>{step.title}</h3>
            <p>{@html step.content}</p>
          </li>
        {/each}
      </ol>

      <p>{@html data.outro}</p>
    </div>

    <div class="res">
      <h2>Resources</h2>
      {#each data.res as i}
        {#if i.startsWith("http")}
          <a href={i}>{parseSiteName(i)}</a>
        {:else}
          <div>
            {@html i}
          </div>
        {/if}
      {/each}
    </div>
  </article>
</div>

